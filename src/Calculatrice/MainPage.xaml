<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.MainPage"
             BackgroundColor="#FAFAFA" Title="Calculatrice" SafeAreaEdges="All"
             SizeChanged="OnPageSizeChanged">
    <Grid Padding="20,12" RowDefinitions="Auto,*" RowSpacing="12">
        <HorizontalStackLayout Spacing="10" SemanticProperties.HeadingLevel="Level1">
            <Label Text="CALCULATRICE" FontSize="14" FontAttributes="Bold"
                   CharacterSpacing="2" TextColor="#191919" VerticalOptions="Center" />
            <Label Text="/" FontSize="16" TextColor="#8A8A8A" VerticalOptions="Center" />
            <Label Text="Standard" FontSize="12" TextColor="#666666" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <ScrollView Grid.Row="1" Orientation="Vertical" VerticalScrollBarVisibility="Never">
            <Grid x:Name="Body" RowDefinitions="Auto,Auto" ColumnDefinitions="*"
                  RowSpacing="16" ColumnSpacing="24" MaximumWidthRequest="900"
                  HorizontalOptions="Fill" VerticalOptions="Start">
                <Border x:Name="DisplayPanel" Stroke="#DEDEDE" StrokeThickness="1"
                        BackgroundColor="White" Padding="18" MinimumHeightRequest="172">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label x:Name="ExpressionLabel" Text=" " TextColor="#666666"
                               FontSize="16" HorizontalTextAlignment="End" LineBreakMode="CharacterWrap"
                               AutomationId="Expression" />
                        <Label x:Name="ResultLabel" Text="0" FontSize="46" TextColor="#191919"
                               HorizontalTextAlignment="End" LineBreakMode="CharacterWrap"
                               AutomationId="Result" SemanticProperties.Description="Résultat : 0" />
                        <Label x:Name="StatusLabel" Text="Prêt à calculer" FontSize="12"
                               TextColor="#666666" HorizontalTextAlignment="End"
                               LineBreakMode="WordWrap" AutomationId="Status" />
                    </VerticalStackLayout>
                </Border>
                <Grid x:Name="Keypad" Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,*,*,*" RowSpacing="10" ColumnSpacing="10">
                    <Button Text="AC" Clicked="OnKeyClicked" Style="{StaticResource UtilityKey}"
                            SemanticProperties.Description="Tout effacer" />
                    <Button Grid.Column="1" Text="±" Clicked="OnKeyClicked" Style="{StaticResource UtilityKey}"
                            SemanticProperties.Description="Changer le signe" />
                    <Button Grid.Column="2" Text="%" Clicked="OnKeyClicked" Style="{StaticResource UtilityKey}"
                            SemanticProperties.Description="Pourcentage" />
                    <Button Grid.Column="3" Text="÷" Clicked="OnKeyClicked" Style="{StaticResource OperatorKey}"
                            SemanticProperties.Description="Diviser" />
                    <Button Grid.Row="1" Text="7" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="2" Text="9" Clicked="OnKeyClicked" />
                    <Button Grid.Row="1" Grid.Column="3" Text="×" Clicked="OnKeyClicked" Style="{StaticResource OperatorKey}"
                            SemanticProperties.Description="Multiplier" />
                    <Button Grid.Row="2" Text="4" Clicked="OnKeyClicked" />
                    <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="OnKeyClicked" />
                    <Button Grid.Row="2" Grid.Column="2" Text="6" Clicked="OnKeyClicked" />
                    <Button Grid.Row="2" Grid.Column="3" Text="−" Clicked="OnKeyClicked" Style="{StaticResource OperatorKey}"
                            SemanticProperties.Description="Soustraire" />
                    <Button Grid.Row="3" Text="1" Clicked="OnKeyClicked" />
                    <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="OnKeyClicked" />
                    <Button Grid.Row="3" Grid.Column="2" Text="3" Clicked="OnKeyClicked" />
                    <Button Grid.Row="3" Grid.Column="3" Text="+" Clicked="OnKeyClicked" Style="{StaticResource OperatorKey}"
                            SemanticProperties.Description="Additionner" />
                    <Button Grid.Row="4" Text="⌫" Clicked="OnKeyClicked" Style="{StaticResource UtilityKey}"
                            SemanticProperties.Description="Effacer le dernier caractère" />
                    <Button Grid.Row="4" Grid.Column="1" Text="0" Clicked="OnKeyClicked" />
                    <Button Grid.Row="4" Grid.Column="2" Text="," Clicked="OnKeyClicked"
                            SemanticProperties.Description="Virgule décimale" />
                    <Button Grid.Row="4" Grid.Column="3" Text="=" Clicked="OnKeyClicked" Style="{StaticResource EqualKey}"
                            SemanticProperties.Description="Calculer le résultat" />
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
