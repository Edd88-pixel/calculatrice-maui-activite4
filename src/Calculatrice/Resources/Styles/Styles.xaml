<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="NumberKey" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#F0F0F0" />
        <Setter Property="TextColor" Value="#191919" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="MinimumWidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters><Setter Property="Scale" Value="0.96" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderColor" Value="#191919" />
                            <Setter Property="BorderWidth" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters><Setter Property="Opacity" Value="0.4" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="InactiveOperation" />
                    <VisualState x:Name="ActiveOperation">
                        <VisualState.Setters><Setter Property="BackgroundColor" Value="#BDBDBD" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource NumberKey}" />
    <Style x:Key="UtilityKey" TargetType="Button" BasedOn="{StaticResource NumberKey}">
        <Setter Property="BackgroundColor" Value="#E4E4E4" />
        <Setter Property="FontSize" Value="20" />
    </Style>
    <Style x:Key="OperatorKey" TargetType="Button" BasedOn="{StaticResource NumberKey}">
        <Setter Property="BackgroundColor" Value="#E4E4E4" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="EqualKey" TargetType="Button" BasedOn="{StaticResource NumberKey}">
        <Setter Property="BackgroundColor" Value="#191919" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
</ResourceDictionary>
